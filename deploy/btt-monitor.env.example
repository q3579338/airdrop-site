# /etc/btt-monitor.env —— BTT 山寨板监控配置(systemd EnvironmentFile,root:root 600)
# 改完 systemctl restart btt-monitor

# 推送(与原版 monitorbitcoin.py 同一套令牌;留空 = 关闭该通道)
BTT_TG_TOKEN=
BTT_TG_CHAT=
BTT_PUSHPLUS_TOKEN=

# 巡检间隔(秒)
BTT_CHECK_EVERY_SEC=300

# 存储与导出(导出文件给 airdrop.satloot.com 生成器读)
BTT_DB=/var/lib/btt-monitor/btt.sqlite
BTT_EXPORT=/var/lib/btt-monitor/export.json
BTT_EXPORT_LIMIT=300

# AI 速览:1 开 0 关;首次启动基准页上的旧帖是否也做速览
BTT_ANALYSIS=1
BTT_SEED_ANALYZE=1
BTT_GROK_MODEL=grok-4.5
BTT_GROK_TIMEOUT_SEC=240
# grok 出网走本机 Xray(与 riskdesk 一致);留空 = 直连
BTT_GROK_PROXY=http://127.0.0.1:10809

# OpenAI 备用(Grok 耗尽时 BTT 速览/空投雷达用);用户自己填
# grok 撞 402(Grok Build usage balance exhausted)时,BTT 速览与名人发币速览切到 OpenAI
# 最便宜的一档(gpt-5-nano,不联网)。留空 = 备用不启用,行为与以前一致。
# NFT 打新追踪不走备用:grok 耗尽期间直接暂停本轮,日志写「grok 耗尽,NFT 追踪暂停」。
# 说明见 README「grok 配额用完时的 OpenAI 备用」
OPENAI_API_KEY=
# 可选:改模型档 / 让 BTT 速览也联网 / 冷却分钟数 / 连败阈值
# OPENAI_MODEL=gpt-5-nano
# BTT_OPENAI_WEB=0
# AI_GROK_RETRY_MIN=60
# AI_GROK_FAIL_STREAK=5
