# /etc/celeb-monitor.env —— 名人发币监控的可选覆盖项(systemd EnvironmentFile,可以不存在)
# 推送令牌、grok 模型/代理默认沿用 /etc/btt-monitor.env 里的 BTT_*;这里的 CELEB_* 存在则优先。
# 改完 systemctl restart celeb-monitor

# 巡检间隔(秒),Google News RSS 10 分钟一轮足够
CELEB_CHECK_EVERY_SEC=600

# 身份词弱命中(没点名、只是标题里有 celebrity/senator/rapper 之类)是否也推送:1 推 0 只入库
CELEB_PUSH_WEAK=1

# AI 速览:1 开 0 关;首次启动基准里的旧事件是否也做速览
CELEB_ANALYSIS=1
CELEB_SEED_ANALYZE=1

# 点名名单默认读 /opt/airdrop-site/celeb/watchlist.json;想在服务器上单独维护就指到别处
#CELEB_WATCHLIST=/etc/celeb-watchlist.json
