[Unit]
Description=airdrop.satloot.com 静态页生成(空投存档 + BTT 新帖 + 名人发币)
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/airdrop-site
Environment=AIRDROP_API_BASE=http://127.0.0.1:5177
Environment=AIRDROP_BTT_JSON=/var/lib/btt-monitor/export.json
Environment=AIRDROP_CELEB_JSON=/var/lib/celeb-monitor/export.json
Environment=AIRDROP_OUT_DIR=/var/www/airdrop-satloot
ExecStart=/usr/bin/node /opt/airdrop-site/build.mjs
